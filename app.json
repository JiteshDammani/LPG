{
  "expo": {
    "name": "LPG Cylinder Tracker",
    "slug": "lpg-cylinder-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lpg-tracker",
    "userInterfaceStyle": "automatic",

    "androidStatusBar": {
      "backgroundColor": "#017DC5"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bpcl.lpgtracker"
    },

    "android": {
      "package": "com.bpcl.lpgtracker",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#017DC5"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#017DC5"
        }
      ],

      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#017DC5"
        }
      ],

      [
        "expo-media-library",
        {
          "photosPermission": "Allow BPCL Stock to save summary images.",
          "savePhotosPermission": "Allow BPCL Stock to save summary images."
        }
      ],

      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-sharing",
      "expo-status-bar"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "e6b42495-1998-490f-b21d-3ce120f15eac"
      }
    }
  }
}